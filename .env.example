# Copier en .env à la racine. Chaque variable est validée au démarrage (apps/*/src/env.ts).

# --- Production uniquement (docker-compose.prod.yml, voir README « Mise en production ») ---
# COMPOSE_FILE=docker-compose.prod.yml
# WEB_BIND=127.0.0.1          # IP de la machine si le reverse proxy est sur une autre machine
# COMPOSE_PROFILES=caddy      # seulement sans reverse proxy existant, avec DOMAIN :
# DOMAIN=bde-mingo.fr

# --- Base de données (docker compose) ---
POSTGRES_USER=bde
POSTGRES_PASSWORD=bde
POSTGRES_DB=bde_mingo
DATABASE_URL=postgres://bde:bde@localhost:5432/bde_mingo
DATABASE_URL_TEST=postgres://bde:bde@localhost:5432/bde_mingo_test

# --- API ---
PORT=3001
WEB_ORIGIN=http://localhost:3000
# Générer avec : openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me
# URL publique de l'auth : le web proxifie /api/auth vers l'API, cookies et liens
# des mails pointent donc vers le web.
BETTER_AUTH_URL=http://localhost:3000

# --- Mails (dev : Mailpit, interface sur http://localhost:8025) ---
# En prod : renseigner le SMTP du BDE.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=BDE Mingo <no-reply@bde-mingo.fr>

# --- Notifications push (optionnel : sans ces 3 variables, le push est désactivé) ---
# Générer les clés une fois : pnpm --filter api push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:bureau@bde-mingo.fr

# --- Web ---
API_URL=http://localhost:3001
