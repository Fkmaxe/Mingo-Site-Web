{
  "openapi": "3.1.0",
  "info": {
    "title": "API BDE Mingo",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "promo": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "student",
                "member",
                "pole_lead",
                "board",
                "treasurer",
                "admin"
              ]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "events:register",
                "staff:register",
                "members:read",
                "events:create",
                "events:update",
                "events:delete",
                "registrations:read",
                "checkin:scan",
                "members:manage",
                "tasks:manage",
                "grades:propose",
                "grades:validate",
                "grades:publish",
                "open-points:validate",
                "open-points:adjust",
                "exports:run",
                "budget:manage",
                "poles:all",
                "roles:manage",
                "settings:manage",
                "audit:read"
              ]
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "promo",
          "image",
          "isAdmin",
          "memberships",
          "roles",
          "permissions"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "pole_lead",
              "board"
            ]
          },
          "boardPosition": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "president",
              "vice_president",
              "secretary",
              "treasurer",
              null
            ]
          },
          "pole": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "slug",
              "name"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "boardPosition",
          "pole"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "DOMAIN_NOT_ALLOWED",
                  "NOT_FOUND",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "L'API répond",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "La base de données est injoignable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "responses": {
          "200": {
            "description": "Utilisateur connecté, ses rôles de l'année en cours",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Pas de session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
