{
  "openapi": "3.1.0",
  "info": {
    "title": "API BDE Mingo",
    "version": "1.0.0"
  },
  "components": {
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "database": {
            "type": "string",
            "enum": [
              "up",
              "down"
            ]
          }
        },
        "required": [
          "status",
          "database"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "promo": {
            "type": [
              "string",
              "null"
            ]
          },
          "image": {
            "type": [
              "string",
              "null"
            ]
          },
          "isAdmin": {
            "type": "boolean"
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "student",
                "member",
                "pole_lead",
                "board",
                "treasurer",
                "admin"
              ]
            }
          },
          "permissions": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "events:register",
                "staff:register",
                "members:read",
                "events:create",
                "events:update",
                "events:delete",
                "registrations:read",
                "checkin:scan",
                "members:manage",
                "tasks:manage",
                "grades:propose",
                "grades:validate",
                "grades:publish",
                "open-points:validate",
                "open-points:adjust",
                "exports:run",
                "budget:manage",
                "poles:all",
                "roles:manage",
                "settings:manage",
                "audit:read"
              ]
            }
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "promo",
          "image",
          "isAdmin",
          "memberships",
          "roles",
          "permissions"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "role": {
            "type": "string",
            "enum": [
              "member",
              "pole_lead",
              "board"
            ]
          },
          "boardPosition": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "president",
              "vice_president",
              "secretary",
              "treasurer",
              null
            ]
          },
          "pole": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "slug",
              "name"
            ]
          }
        },
        "required": [
          "id",
          "role",
          "boardPosition",
          "pole"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "VALIDATION_ERROR",
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "DOMAIN_NOT_ALLOWED",
                  "NOT_FOUND",
                  "INVALID_STATUS_TRANSITION",
                  "ALREADY_REGISTERED",
                  "EVENT_FULL",
                  "REGISTRATION_CLOSED",
                  "DEADLINE_PASSED",
                  "INTERNAL_ERROR"
                ]
              },
              "message": {
                "type": "string"
              },
              "details": {}
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Pole": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "description"
        ]
      },
      "Event": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "students",
              "members"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "published",
              "cancelled",
              "done"
            ]
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ]
          },
          "registrationDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "openPointsValue": {
            "type": "integer"
          },
          "posterUrl": {
            "type": [
              "string",
              "null"
            ]
          },
          "pole": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "slug": {
                "type": "string"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "slug",
              "name"
            ]
          },
          "canManage": {
            "type": "boolean"
          },
          "confirmedCount": {
            "type": "integer"
          },
          "registrationState": {
            "type": "string",
            "enum": [
              "open",
              "full",
              "closed"
            ]
          },
          "myRegistration": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "status": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "waitlisted",
                  "cancelled"
                ]
              }
            },
            "required": [
              "id",
              "status"
            ]
          }
        },
        "required": [
          "id",
          "slug",
          "title",
          "description",
          "location",
          "startsAt",
          "endsAt",
          "visibility",
          "status",
          "capacity",
          "registrationDeadline",
          "openPointsValue",
          "posterUrl",
          "pole",
          "canManage",
          "confirmedCount",
          "registrationState",
          "myRegistration"
        ]
      },
      "CreateEventInput": {
        "type": "object",
        "properties": {
          "poleId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 5000,
            "default": ""
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "students",
              "members"
            ]
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 10000,
            "default": null
          },
          "registrationDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "default": null
          },
          "openPointsValue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "default": 0
          },
          "posterUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri",
            "default": null
          }
        },
        "required": [
          "poleId",
          "title",
          "location",
          "startsAt",
          "endsAt",
          "visibility"
        ]
      },
      "UpdateEventInput": {
        "type": "object",
        "properties": {
          "poleId": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 120
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "location": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "public",
              "students",
              "members"
            ]
          },
          "capacity": {
            "type": [
              "integer",
              "null"
            ],
            "exclusiveMinimum": 0,
            "maximum": 10000
          },
          "registrationDeadline": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "openPointsValue": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "posterUrl": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          }
        }
      },
      "Ticket": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "waitlisted",
              "cancelled"
            ]
          },
          "qrToken": {
            "type": "string"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "cancelledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "event": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "slug": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "location": {
                "type": "string"
              },
              "startsAt": {
                "type": "string",
                "format": "date-time"
              },
              "endsAt": {
                "type": "string",
                "format": "date-time"
              },
              "status": {
                "type": "string",
                "enum": [
                  "draft",
                  "published",
                  "cancelled",
                  "done"
                ]
              }
            },
            "required": [
              "id",
              "slug",
              "title",
              "location",
              "startsAt",
              "endsAt",
              "status"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "qrToken",
          "createdAt",
          "cancelledAt",
          "event"
        ]
      },
      "Registrant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "confirmed",
              "waitlisted",
              "cancelled"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "promo": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "name",
              "email",
              "promo"
            ]
          }
        },
        "required": [
          "id",
          "status",
          "createdAt",
          "user"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "health"
        ],
        "responses": {
          "200": {
            "description": "L'API répond",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "503": {
            "description": "La base de données est injoignable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/v1/me": {
      "get": {
        "tags": [
          "me"
        ],
        "responses": {
          "200": {
            "description": "Utilisateur connecté, ses rôles de l'année en cours",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Pas de session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/poles": {
      "get": {
        "tags": [
          "poles"
        ],
        "responses": {
          "200": {
            "description": "Pôles du BDE",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pole"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "enum": [
                "upcoming",
                "past"
              ],
              "default": "upcoming"
            },
            "required": false,
            "name": "scope",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": false,
            "name": "poleId",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "default": false
            },
            "required": false,
            "name": "manageable",
            "in": "query"
          },
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Événements visibles par l'utilisateur",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "items": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Event"
                      }
                    },
                    "nextCursor": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "items",
                    "nextCursor"
                  ]
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "events"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateEventInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Événement créé (brouillon)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Pas de session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Pas le droit de créer un événement pour ce pôle",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventRef}": {
      "get": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "required": true,
            "name": "eventRef",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Détail d'un événement (par id ou slug)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "404": {
            "description": "Événement absent ou invisible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}": {
      "patch": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "eventId",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateEventInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Événement modifié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "400": {
            "description": "Données invalides",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Pas le droit de modifier cet événement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Événement introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Événement annulé ou terminé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "eventId",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Brouillon supprimé"
          },
          "403": {
            "description": "Pas le droit de supprimer cet événement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Événement introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Seul un brouillon peut être supprimé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/publish": {
      "post": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "eventId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Événement publié",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "403": {
            "description": "Pas le droit de gérer cet événement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Événement introuvable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "409": {
            "description": "Transition de statut impossible",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events/{eventId}/cancel": {
      "post": {
        "tags": [
          "events"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "eventId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Événement annulé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Event"
                }
              }
            }
          },
          "403": {
            "description": "Pas le droit de gérer cet événement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Événement introuvable",
            "content": {
              "application/json": {
                "schema": {
