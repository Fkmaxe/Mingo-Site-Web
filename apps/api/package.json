{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --exclude \"../../node_modules/**\" --env-file-if-exists=../../.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/scripts/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "openapi:export": "tsx src/scripts/openapi-export.ts openapi.json",
    "build": "tsup",
    "start": "node --enable-source-maps dist/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@bde/shared": "workspace:*",
    "@hono/node-server": "^2.1.3",
    "@hono/zod-openapi": "^1.6.3",
    "@scalar/hono-api-reference": "^0.12.10",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "hono": "^4.13.13",
    "nodemailer": "^10.0.15",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  }
}
