{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "env": ["API_URL", "SITE_URL"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "env": ["API_URL", "SITE_URL"]
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL_TEST"]
    }
  }
}
